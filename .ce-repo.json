{
  "name": "cubeescape-critic",
  "version": {
    "file": "CHANGELOG.md",
    "pattern": "(?m)^## (\\d+\\.\\d+(?:\\.\\d+)?)"
  },
  "version_name": "Livery",
  "check": {
    "quick": [
      [
        "python3",
        "check"
      ]
    ]
  },
  "docs": {
    "changelog": "CHANGELOG.md",
    "agent_sections": [
      "Was hier liegt",
      "Regeln"
    ]
  },
  "coordination": {
    "repo": "ffunkfabian-hash/cubeescape-nexogen",
    "registry": "https://github.com/ffunkfabian-hash/cubeescape-nexogen/blob/main/repos.json"
  },
  "tools_version": {
    "version": "0.43.1",
    "commit": "8adca7d5d3eced583a71c753ca4668faea78157b"
  },
  "core_paths": [
    "critic/schema.json",
    "web/src/robotgen/data/SOURCE.json",
    "assets/robot-bodies-three/*/manifest.json"
  ]
}
